[Unit]
Description=Legal Query Assistant V3.4
After=network.target

[Service]
Type=simple
User=CHANGE_ME
Group=CHANGE_ME
WorkingDirectory=/opt/legal-assistant
Environment="MFD_SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_VALUE"
ExecStart=/opt/legal-assistant/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:5000 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
